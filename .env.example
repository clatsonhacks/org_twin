# ---- AI: Vultr Serverless Inference (OpenAI-compatible) ----
# Console → Products → Serverless → Inference → your subscription → API key
# (the inference subscription key, not the account API key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.vultrinference.com/v1
# Use the OpenAI-compatible engine with the key above, and pin a Vultr model.
AGENT_ENGINE=ai-sdk:openai
AGENT_ENGINE_PREFER_BYO_KEY=true
# Any chat model listed by GET https://api.vultrinference.com/v1/models
AGENT_MODEL=qwen3.8-27b

# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# ---- Or use the Vultr names directly (mapped to the settings above at startup) ----
# VULTR_INFERENCE_API_KEY=
# VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# VULTR_INFERENCE_MODEL=qwen3.8-27b
# Vision model for the Skill Recorder (auto-detected if empty)
VULTR_VISION_MODEL=

# ---- Connectors (or add them in Settings). Missing = demo mode. ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_REDIRECT_TO=
NOTION_TOKEN=
NOTION_DATABASE_ID=
HUBSPOT_TOKEN=
STRIPE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GITHUB_TOKEN=
GITHUB_REPO=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
WEBHOOK_ENABLED=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_HTTP=false

# ---- One-click "Connect" (sign-in popups instead of pasted keys) ----
# Register OrgTwin once with each service and set its client id + secret. Redirect URI to register:
#   <app address>/api/oauth/<google|stripe|notion|slack|discord|hubspot>/callback
#   e.g. http://localhost:8080/api/oauth/google/callback
# Optional: force the address used in redirect URIs (behind a proxy, or a fixed public domain).
# OAUTH_REDIRECT_BASE_URL=https://orgtwin.example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_SECRET_KEY=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Telegram one-tap connect uses TELEGRAM_BOT_TOKEN above (people press Start in Telegram; no chat id needed).

# ---- Limits on the AI key (checked before every new chat turn and Skill Recorder call; 0 = no limit) ----
# Days are UTC. A chat turn costs roughly 50–100k tokens.
AI_LIMIT_USER_DAILY_TURNS=15
AI_LIMIT_USER_DAILY_TOKENS=1000000
AI_LIMIT_USER_PER_MINUTE=3
AI_LIMIT_DAILY_TOKENS=1500000
# Comma-separated emails without per-person limits (the app-wide limit still applies)
AI_LIMIT_EXEMPT_EMAILS=
