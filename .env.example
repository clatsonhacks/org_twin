# ---- AI: Vultr Serverless Inference (OpenAI-compatible) ----
# Console → Products → Serverless → Inference → your subscription → API key
# (the inference subscription key, not the account API key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.vultrinference.com/v1
# Use the OpenAI-compatible engine with the key above, and pin a Vultr model.
AGENT_ENGINE=ai-sdk:openai
AGENT_ENGINE_PREFER_BYO_KEY=true
# Any chat model listed by GET https://api.vultrinference.com/v1/models
AGENT_MODEL=qwen3.8-27b

# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# ---- Or use the Vultr names directly (mapped to the settings above at startup) ----
# VULTR_INFERENCE_API_KEY=
# VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# VULTR_INFERENCE_MODEL=qwen3.8-27b
# Vision model for the Skill Recorder (auto-detected if empty)
VULTR_VISION_MODEL=

# ---- Connectors (or add them in Settings). Missing = demo mode. ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_REDIRECT_TO=
NOTION_TOKEN=
NOTION_DATABASE_ID=
HUBSPOT_TOKEN=
STRIPE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GITHUB_TOKEN=
GITHUB_REPO=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
WEBHOOK_ENABLED=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_HTTP=false
